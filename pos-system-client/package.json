{
  "name": "pos-system-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --schema=../pos-system-server/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint . && pnpm --ignore-workspace run test",
    "postinstall": "prisma generate --schema=../pos-system-server/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../pos-system-server/prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:time": "node --test test/business-time.test.mjs src/actions/reports/business-day.test.mjs src/actions/purchase/purchase-number.test.mjs",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "db:seed:verify": "tsx prisma/seed-verify.ts",
    "test:seed:guard": "tsx --test prisma/seed-guard.test.ts",
    "test:purchase:access": "node --test src/actions/purchase/*.test.mjs",
    "test": "node --test test/*.test.mjs src/lib/auth/*.test.mjs src/actions/*/*.test.mjs",
    "test:actions:guard": "node --test test/actions-guard.test.mjs",
    "test:sale:access": "node --test src/lib/auth/actor.test.mjs src/actions/sale/*.test.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "6.14.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "@uploadthing/react": "^7.3.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.17",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.539.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.92.0",
    "react-number-format": "^5.4.5",
    "recharts": "2.15.4",
    "sonner": "^2.0.8",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4",
    "vaul": "^1.1.2",
    "yup": "^1.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "prisma": "6.14.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808",
  "pnpm": {
    "overrides": {
      "effect": "^3.20.0",
      "next>postcss": "^8.5.33",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
