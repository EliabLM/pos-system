// El schema es propiedad del server (Fase 1). Mientras dure el strangler-fig el
// client sigue consumiendo el cliente generado en su propio arbol via `@/generated/prisma`;
// cuando el server incorpore Prisma en runtime (Fase 2) se agrega aca un segundo
// generator con output local al server.
//
// Soft-delete uniqueness: enforced by PARTIAL unique indexes in SQL migrations
// (`WHERE deleted_at IS NULL`) — Prisma cannot express them, so they are not
// declared here (its diff engine ignores them). See migration
// 20260820130000_soft_delete_partial_uniques. Duplicates still surface as P2002.
generator client {
  provider      = "prisma-client-js"
  output        = "../../pos-system-client/src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // D3.10: slug único global para URLs multi-tenant. DEFAULT '' + trigger
  // organizations_slug_default lo generan desde name al insertar (Receta R7),
  // así el client legacy puede seguir creando orgs sin enviarlo.
  slug           String          @unique @default("")
  name           String
  email          String
  nit            String?
  phone          String?
  address        String?
  city           String?
  department     String?
  taxId          String?         @map("tax_id")
  // Campos del modelo organization de Better Auth (#20); la app no los usa.
  logo           String?
  metadata       String?
  isActive       Boolean         @default(true) @map("is_active")
  isDeleted      Boolean         @default(false) @map("is_deleted")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  brands         Brand[]
  categories     Category[]
  customers      Customer[]
  memberships    Membership[]
  invitations    Invitation[]
  activeSessions Session[]
  paymentMethods PaymentMethod[]
  products       Product[]
  stockMovements StockMovement[]
  stores         Store[]
  suppliers      Supplier[]
  systemConfigs  SystemConfig[]
  unitMeasures   UnitMeasure[]

  @@map("organizations")
}

model Store {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  name             String
  description      String?
  address          String
  city             String?
  department       String?
  phone            String?
  saleNumberPrefix String       @default("") @map("sale_number_prefix")
  lastSaleNumber   Int          @default(0) @map("last_sale_number")
  isActive         Boolean      @default(true) @map("is_active")
  isDeleted        Boolean      @default(false) @map("is_deleted")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz
  sales            Sale[]
  organization     Organization @relation(fields: [organizationId], references: [id])
  memberships      Membership[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("stores")
}

// Identidad GLOBAL (D3.3–D3.6): la tenancy (org, store, role) vive en
// memberships. Sin RLS directo — como sessions/verifications, los flujos de
// auth corren antes de conocer el tenant; memberships sí está bajo RLS.
model User {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  // Credenciales de autenticación (login por email — D3.4)
  email        String
  passwordHash String? @map("password_hash") // D3.6: nullable para futuro OAuth/passkey

  // Información personal (D3.5: first+last → name)
  name  String
  image String? // avatar URL

  emailVerified Boolean @default(false) @map("email_verified")

  // Soft delete pattern
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Campos de seguridad adicionales
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz // Para invalidar tokens antiguos
  loginAttempts     Int       @default(0) @map("login_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz // Account lockout por intentos fallidos

  // Relaciones
  sales          Sale[]
  stockMovements StockMovement[]
  sessions       Session[]
  auditLogs      AuditLog[]
  memberships    Membership[]
  accounts       Account[]
  invitations    Invitation[]

  // unique (email) WHERE deleted_at IS NULL — partial index in SQL
  @@index([email, isDeleted])
  @@index([lastLoginAt])
  @@map("users")
}

// ============================================
// MODELO SESSION - MANEJO DE JWT/SESIONES
// ============================================
model Session {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Token y seguridad
  // Token de sesión de Better Auth (#19); la cookie lleva este valor firmado.
  token                String?  @unique
  // Legado del JWT propio (antes de #19): ya no se escribe.
  tokenHash            String?  @unique @map("token_hash")
  // Refresh rotation (D3/R8) — el módulo auth de Fase 2 los llena
  refreshTokenHash     String?  @unique @map("refresh_token_hash")
  rotatedFrom          String?  @map("rotated_from") @db.Uuid // reuse-detection chain
  expiresAt            DateTime @map("expires_at") @db.Timestamptz
  // Organización activa (plugin organization de Better Auth, #20): getActor()
  // toma de aquí el tenant.
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid

  // Metadata de seguridad
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  deviceId  String? @map("device_id") // Fingerprint del dispositivo

  // Control de sesión
  isActive  Boolean   @default(true) @map("is_active")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz // Para invalidación explícita
  revokedBy String?   @map("revoked_by") @db.Uuid // userId que revocó (admin)

  // Metadata adicional
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relación
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  // Índices para queries eficientes
  @@index([userId, isActive])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

// ============================================
// MODELO AUDIT LOG - TRAZABILIDAD
// ============================================
// D3.8: actor-action-target + contexto de tenancy + correlationId (trace distribuido)
model AuditLog {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid // Nullable para acciones del sistema

  // Información del evento
  action     AuditAction
  targetType String?     @map("target_type") // nombre de tabla/entidad afectada
  targetId   String?     @map("target_id") @db.Uuid // ID del registro afectado

  // Detalles del cambio
  oldValues Json? @map("old_values") // Estado anterior
  newValues Json? @map("new_values") // Estado nuevo

  // Metadata de seguridad
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Contexto de tenancy + trace
  organizationId String? @map("organization_id") @db.Uuid
  storeId        String? @map("store_id") @db.Uuid
  correlationId  String? @map("correlation_id") // distributed trace id
  metadata       Json? // Datos adicionales flexibles

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relación
  user User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Índices para consultas
  @@index([actorUserId])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Category {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("categories")
}

model Brand {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  logo           String?
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("brands")
}

model UnitMeasure {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  abbreviation   String
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  products       Product[]
  saleItems      SaleItem[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  // unique (organization_id, name) / (organization_id, abbreviation)
  // WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted])
  @@map("unit_measures")
}

model Product {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  description    String?
  image          String?
  barcode        String?
  sku            String?
  categoryId     String?         @map("category_id") @db.Uuid
  brandId        String?         @map("brand_id") @db.Uuid
  unitMeasureId  String?         @map("unit_measure_id") @db.Uuid
  costPrice      Decimal         @map("cost_price") @db.Decimal(12, 2)
  salePrice      Decimal         @map("sale_price") @db.Decimal(12, 2)
  minStock       Int             @default(0) @map("min_stock")
  currentStock   Int             @default(0) @map("current_stock")
  alcoholGrade   Float?          @map("alcohol_grade")
  volume         Float?
  size           String?
  color          String?
  model          String?
  isActive       Boolean         @default(true) @map("is_active")
  isDeleted      Boolean         @default(false) @map("is_deleted")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  brand          Brand?          @relation(fields: [brandId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  unitMeasure    UnitMeasure?    @relation(fields: [unitMeasureId], references: [id])
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  // unique (organization_id, barcode) / (organization_id, sku)
  // WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitMeasureId])
  @@map("products")
}

model Customer {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  address        String?
  city           String?
  department     String?
  document       String?
  documentType   String?      @map("document_type")
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  sales          Sale[]

  // unique (organization_id, email) / (organization_id, document)
  // WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted])
  @@map("customers")
}

model Supplier {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  contactName    String?      @map("contact_name")
  email          String?
  phone          String?
  address        String?
  city           String?
  department     String?
  taxId          String?      @map("tax_id")
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  purchases      Purchase[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  // unique (organization_id, tax_id) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("suppliers")
}

model PaymentMethod {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  type           PaymentType
  isActive       Boolean       @default(true) @map("is_active")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  salePayments   SalePayment[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("payment_methods")
}

model Sale {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  saleNumber     String        @map("sale_number")
  customerId     String?       @map("customer_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  subtotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(PAID)
  saleDate       DateTime      @default(now()) @map("sale_date") @db.Timestamptz
  dueDate        DateTime?     @map("due_date") @db.Timestamptz
  paidDate       DateTime?     @map("paid_date") @db.Timestamptz
  notes          String?
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  saleItems      SaleItem[]
  salePayments   SalePayment[]
  customer       Customer?     @relation(fields: [customerId], references: [id])
  store          Store         @relation(fields: [storeId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  // unique (store_id, sale_number) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted, saleDate])
  @@index([storeId])
  @@index([customerId])
  @@index([userId])
  @@map("sales")
}

model SaleItem {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  saleId        String       @map("sale_id") @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  unitMeasureId String?      @map("unit_measure_id") @db.Uuid
  quantity      Int
  unitPrice     Decimal      @map("unit_price") @db.Decimal(12, 2)
  subtotal      Decimal      @db.Decimal(12, 2)
  isDeleted     Boolean      @default(false) @map("is_deleted")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz
  product       Product      @relation(fields: [productId], references: [id])
  sale          Sale         @relation(fields: [saleId], references: [id])
  unitMeasure   UnitMeasure? @relation(fields: [unitMeasureId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([unitMeasureId])
  @@map("sale_items")
}

model SalePayment {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  saleId          String        @map("sale_id") @db.Uuid
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  notes           String?
  paymentDate     DateTime      @default(now()) @map("payment_date") @db.Timestamptz
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  sale            Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([paymentMethodId])
  @@map("sale_payments")
}

model Purchase {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  supplierId     String         @map("supplier_id") @db.Uuid
  purchaseNumber String         @map("purchase_number")
  total          Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(PENDING)
  purchaseDate   DateTime       @default(now()) @map("purchase_date") @db.Timestamptz
  receivedDate   DateTime?      @map("received_date") @db.Timestamptz
  notes          String?
  isDeleted      Boolean        @default(false) @map("is_deleted")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz
  purchaseItems  PurchaseItem[]
  supplier       Supplier       @relation(fields: [supplierId], references: [id])

  @@index([organizationId, isDeleted, purchaseDate])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purchaseId String    @map("purchase_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal   @map("unit_price") @db.Decimal(12, 2)
  subtotal   Decimal   @db.Decimal(12, 2)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  product    Product   @relation(fields: [productId], references: [id])
  purchase   Purchase  @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model StockMovement {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  storeId        String?           @map("store_id") @db.Uuid
  type           StockMovementType
  quantity       Int
  previousStock  Int               @map("previous_stock")
  newStock       Int               @map("new_stock")
  reason         String?
  userId         String?           @map("user_id") @db.Uuid
  reference      String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization      @relation(fields: [organizationId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  user           User?             @relation(fields: [userId], references: [id])

  @@index([organizationId, productId, createdAt])
  @@index([productId])
  @@index([userId])
  @@index([storeId])
  @@map("stock_movements")
}

model SystemConfig {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  value          String
  type           String       @default("STRING")
  description    String?
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])

  // unique (organization_id, key) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("system_configs")
}

// ============================================
// AUTH TARGET (Fase 1 paso 3 — docs/auth/AUTH_TARGET_SCHEMA.md)
// ============================================

// D3.3 — desacopla user↔organization: member-roles, default store, invitaciones.
// users conserva organizationId/storeId/role hasta el bloque 3c del paso 3.
model Membership {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  role           MembershipRole   @default(SELLER)
  defaultStoreId String?          @map("default_store_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  invitedBy      String?          @map("invited_by") @db.Uuid
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultStore Store?       @relation(fields: [defaultStoreId], references: [id])

  // unique (user_id, organization_id) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, role])
  @@index([userId])
  @@index([defaultStoreId])
  @@map("memberships")
}

// D3.7 — unifica password_resets + email_verifications (+ magic-link/change-email
// futuros). Las tablas viejas se eliminan en el bloque 3b cuando el client migre.
// Invitación de un ADMIN para que un correo entre a su organización (#20,
// plugin organization de Better Auth). El id es el secreto del enlace (UUIDv4).
model Invitation {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  email          String
  role           MembershipRole @default(SELLER)
  // pending | accepted | rejected | canceled (CHECK en SQL)
  status         String         @default("pending")
  inviterId      String         @map("inviter_id") @db.Uuid
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@index([inviterId])
  @@map("invitations")
}

model Verification {
  id         String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String // email (o userId para tipos futuros)
  // Better Auth (#19) guarda el valor tal cual en `value`; valueHash y type quedan
  // del diseño D3.7 y son opcionales.
  value      String?
  valueHash  String?           @unique @map("value_hash")
  type       VerificationType?
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz
  used       Boolean           @default(false)
  usedAt     DateTime?         @map("used_at") @db.Timestamptz
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier, type, used])
  @@index([expiresAt])
  @@map("verifications")
}

// D3.9 — skeleton OAuth/passkey/credential por user. Schema ahora; datos en Fase 2+.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id") // "google" | "apple" | "passkey" | "credential" | "totp"
  accountId             String    @map("account_id") // id externo (sub, credentialId)
  accessToken           String?   @map("access_token") // encrypted at rest (Fase 2)
  refreshToken          String?   @map("refresh_token")
  expiresAt             DateTime? @map("expires_at") @db.Timestamptz
  metadata              Json?
  // Columnas que usa Better Auth (#19). Con providerId "credential",
  // `password` guarda el hash bcrypt de la contraseña.
  password              String?
  idToken               String?   @map("id_token")
  scope                 String?
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Puente cuid→UUIDv7 (Receta R1 de la migración). Durante la transición la API
// acepta ids legacy via lookup en esta tabla; se elimina tras Fase 5.
model LegacyIdMap {
  entity   String
  legacyId String @map("legacy_id")
  newUuid  String @map("new_uuid") @db.Uuid

  @@id([entity, legacyId])
  @@map("legacy_id_map")
}

enum MembershipRole {
  ADMIN
  SELLER

  @@map("membership_role")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED

  @@map("membership_status")
}

enum VerificationType {
  PASSWORD_RESET
  EMAIL_VERIFY
  MAGIC_LINK
  CHANGE_EMAIL

  @@map("verification_type")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT

  @@map("stock_movement_type")
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  CREDIT
  CHECK
  OTHER

  @@map("payment_type")
}

enum SaleStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED

  @@map("sale_status")
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED

  @@map("purchase_status")
}

// ============================================
// ENUM AUDIT ACTION - ACCIONES DE AUDITORÍA
// ============================================
enum AuditAction {
  // Autenticación
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED

  // CRUD genérico
  CREATE
  READ
  UPDATE
  DELETE
  RESTORE

  // Acciones específicas
  ROLE_CHANGED
  ORGANIZATION_CHANGED
  STORE_CHANGED
  SESSION_REVOKED

  // Valores del target D3.8 (los legacy de arriba se conservan: Postgres no
  // permite quitar valores de un enum y hay filas históricas que los usan)
  LOGOUT_ALL
  PASSWORD_CHANGE
  ROLE_CHANGE
  SOFT_DELETE
  EXPORT
  VIEW_SENSITIVE

  @@map("audit_action")
}
