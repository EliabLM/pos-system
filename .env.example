# .env.example para docker-compose local (cp .env.example .env).
# Solo POSTGRES_* y CLIENT_AUTH_SECRET son obligatorios para local. Lo demas tiene defaults.

# ---- Postgres local ----
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos

# ---- pos-system-client ----
# Secreto de Better Auth (firma las cookies de sesión). Mínimo 32 caracteres.
# Genera uno con:  openssl rand -base64 48
CLIENT_AUTH_SECRET=replace-me-with-a-32+-char-secret
# URL pública del client (Better Auth la usa para validar el origen).
CLIENT_AUTH_URL=http://localhost:3000
# Imágenes de producto: directorio local (en Coolify, un volumen persistente).
# Vacío en local = ./pos-system-client/.uploads. Límite de subida en MB (por defecto 5).
UPLOADS_DIR=
MAX_IMAGE_UPLOAD_MB=5
# URL publica del server (cuando Fase 2 lo exponga). Por defecto el server local.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ---- pos-system-server ----
# Fase 2 llena JWT. La conexion a la DB local la arma docker-compose desde
# POSTGRES_* (el server es dueño del schema y aplica las migraciones al arrancar).
SERVER_JWT_SECRET=

# ---- pos-system-app ----
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1