// El schema es propiedad del server (Fase 1). Mientras dure el strangler-fig el
// client sigue consumiendo el cliente generado en su propio arbol via `@/generated/prisma`;
// cuando el server incorpore Prisma en runtime (Fase 2) se agrega aca un segundo
// generator con output local al server.
//
// Soft-delete uniqueness: enforced by PARTIAL unique indexes in SQL migrations
// (`WHERE deleted_at IS NULL`) — Prisma cannot express them, so they are not
// declared here (its diff engine ignores them). See migration
// 20260820130000_soft_delete_partial_uniques. Duplicates still surface as P2002.
generator client {
  provider      = "prisma-client-js"
  output        = "../../pos-system-client/src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  email          String
  nit            String?
  phone          String?
  address        String?
  city           String?
  department     String?
  taxId          String?         @map("tax_id")
  isActive       Boolean         @default(true) @map("is_active")
  isDeleted      Boolean         @default(false) @map("is_deleted")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  brands         Brand[]
  categories     Category[]
  customers      Customer[]
  paymentMethods PaymentMethod[]
  products       Product[]
  stockMovements StockMovement[]
  stores         Store[]
  suppliers      Supplier[]
  systemConfigs  SystemConfig[]
  unitMeasures   UnitMeasure[]
  users          User[]

  @@map("organizations")
}

model Store {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  name             String
  description      String?
  address          String
  city             String?
  department       String?
  phone            String?
  saleNumberPrefix String       @default("") @map("sale_number_prefix")
  lastSaleNumber   Int          @default(0) @map("last_sale_number")
  isActive         Boolean      @default(true) @map("is_active")
  isDeleted        Boolean      @default(false) @map("is_deleted")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz
  sales            Sale[]
  organization     Organization @relation(fields: [organizationId], references: [id])
  users            User[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("stores")
}

model User {
  id String @id @default(cuid())

  // Multi-tenancy
  organizationId String? @map("organization_id")
  storeId        String? @map("store_id")

  // Credenciales de autenticación
  email    String
  password String // Hash bcrypt
  username String

  // Información personal
  firstName String @map("first_name")
  lastName  String @map("last_name")

  // Control de acceso
  role          UserRole @default(SELLER)
  emailVerified Boolean  @default(false) @map("email_verified")

  // Soft delete pattern
  isActive  Boolean   @default(true) @map("is_active")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Campos de seguridad adicionales
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz // Para invalidar tokens antiguos
  loginAttempts     Int       @default(0) @map("login_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz // Account lockout por intentos fallidos

  // Relaciones existentes
  sales          Sale[]
  stockMovements StockMovement[]
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  store          Store?          @relation(fields: [storeId], references: [id])

  // Nuevas relaciones de autenticación
  sessions           Session[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  auditLogs          AuditLog[]

  // unique (email) / (username) WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted, isActive])
  @@index([email, isDeleted])
  @@index([lastLoginAt])
  @@index([storeId])
  @@map("users")
}

// ============================================
// MODELO SESSION - MANEJO DE JWT/SESIONES
// ============================================
model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Token y seguridad
  token     String   @unique // Hash del JWT o session ID
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  // Metadata de seguridad
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  deviceId  String? @map("device_id") // Fingerprint del dispositivo

  // Control de sesión
  isActive  Boolean   @default(true) @map("is_active")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz // Para invalidación explícita
  revokedBy String?   @map("revoked_by") // userId que revocó (admin)

  // Metadata adicional
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relación
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices para queries eficientes
  @@index([userId, isActive])
  @@index([token])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

// ============================================
// MODELO PASSWORD RESET - RECUPERACIÓN
// ============================================
model PasswordReset {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Token de reset
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  // Control de uso
  used   Boolean   @default(false)
  usedAt DateTime? @map("used_at") @db.Timestamptz

  // Metadata de seguridad
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relación
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices
  @@index([userId, used])
  @@index([token])
  @@index([expiresAt])
  @@map("password_resets")
}

// ============================================
// MODELO EMAIL VERIFICATION - VERIFICACIÓN
// ============================================
model EmailVerification {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Token de verificación
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  // Email a verificar (permite cambio de email)
  email String

  // Control de uso
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz

  // Metadata
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relación
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices
  @@index([userId, verified])
  @@index([token])
  @@index([expiresAt])
  @@index([email])
  @@map("email_verifications")
}

// ============================================
// MODELO AUDIT LOG - TRAZABILIDAD
// ============================================
model AuditLog {
  id     String  @id @default(cuid())
  userId String? @map("user_id") // Nullable para acciones del sistema

  // Información del evento
  action   AuditAction
  entity   String // Nombre de la tabla/entidad afectada
  entityId String? @map("entity_id") // ID del registro afectado

  // Detalles del cambio
  oldValues Json? @map("old_values") // Estado anterior
  newValues Json? @map("new_values") // Estado nuevo

  // Metadata de seguridad
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Contexto adicional
  organizationId String? @map("organization_id") // Para filtrar por organización
  metadata       Json? // Datos adicionales flexibles

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relación
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Índices para consultas
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("categories")
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  logo           String?
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("brands")
}

model UnitMeasure {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  abbreviation   String
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  products       Product[]
  saleItems      SaleItem[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  // unique (organization_id, name) / (organization_id, abbreviation)
  // WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted])
  @@map("unit_measures")
}

model Product {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  description    String?
  image          String?
  barcode        String?
  sku            String?
  categoryId     String?         @map("category_id")
  brandId        String?         @map("brand_id")
  unitMeasureId  String?         @map("unit_measure_id")
  costPrice      Decimal         @map("cost_price") @db.Decimal(12, 2)
  salePrice      Decimal         @map("sale_price") @db.Decimal(12, 2)
  minStock       Int             @default(0) @map("min_stock")
  currentStock   Int             @default(0) @map("current_stock")
  alcoholGrade   Float?          @map("alcohol_grade")
  volume         Float?
  size           String?
  color          String?
  model          String?
  isActive       Boolean         @default(true) @map("is_active")
  isDeleted      Boolean         @default(false) @map("is_deleted")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  brand          Brand?          @relation(fields: [brandId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  unitMeasure    UnitMeasure?    @relation(fields: [unitMeasureId], references: [id])
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  // unique (organization_id, barcode) / (organization_id, sku)
  // WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitMeasureId])
  @@map("products")
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  address        String?
  city           String?
  department     String?
  document       String?
  documentType   String?      @map("document_type")
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])
  sales          Sale[]

  // unique (organization_id, email) / (organization_id, document)
  // WHERE deleted_at IS NULL — partial indexes in SQL
  @@index([organizationId, isDeleted])
  @@map("customers")
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  contactName    String?      @map("contact_name")
  email          String?
  phone          String?
  address        String?
  city           String?
  department     String?
  taxId          String?      @map("tax_id")
  isActive       Boolean      @default(true) @map("is_active")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  purchases      Purchase[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  // unique (organization_id, tax_id) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("suppliers")
}

model PaymentMethod {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  name           String
  type           PaymentType
  isActive       Boolean       @default(true) @map("is_active")
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id])
  salePayments   SalePayment[]

  // unique (organization_id, name) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("payment_methods")
}

model Sale {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  storeId        String        @map("store_id")
  saleNumber     String        @map("sale_number")
  customerId     String?       @map("customer_id")
  userId         String        @map("user_id")
  subtotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(PAID)
  saleDate       DateTime      @default(now()) @map("sale_date") @db.Timestamptz
  dueDate        DateTime?     @map("due_date") @db.Timestamptz
  paidDate       DateTime?     @map("paid_date") @db.Timestamptz
  notes          String?
  isDeleted      Boolean       @default(false) @map("is_deleted")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  saleItems      SaleItem[]
  salePayments   SalePayment[]
  customer       Customer?     @relation(fields: [customerId], references: [id])
  store          Store         @relation(fields: [storeId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  // unique (store_id, sale_number) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted, saleDate])
  @@index([storeId])
  @@index([customerId])
  @@index([userId])
  @@map("sales")
}

model SaleItem {
  id            String       @id @default(cuid())
  saleId        String       @map("sale_id")
  productId     String       @map("product_id")
  unitMeasureId String?      @map("unit_measure_id")
  quantity      Int
  unitPrice     Decimal      @map("unit_price") @db.Decimal(12, 2)
  subtotal      Decimal      @db.Decimal(12, 2)
  isDeleted     Boolean      @default(false) @map("is_deleted")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz
  product       Product      @relation(fields: [productId], references: [id])
  sale          Sale         @relation(fields: [saleId], references: [id])
  unitMeasure   UnitMeasure? @relation(fields: [unitMeasureId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([unitMeasureId])
  @@map("sale_items")
}

model SalePayment {
  id              String        @id @default(cuid())
  saleId          String        @map("sale_id")
  paymentMethodId String        @map("payment_method_id")
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  notes           String?
  paymentDate     DateTime      @default(now()) @map("payment_date") @db.Timestamptz
  isDeleted       Boolean       @default(false) @map("is_deleted")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  sale            Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([paymentMethodId])
  @@map("sale_payments")
}

model Purchase {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  supplierId     String         @map("supplier_id")
  purchaseNumber String         @map("purchase_number")
  total          Decimal        @db.Decimal(12, 2)
  status         PurchaseStatus @default(PENDING)
  purchaseDate   DateTime       @default(now()) @map("purchase_date") @db.Timestamptz
  receivedDate   DateTime?      @map("received_date") @db.Timestamptz
  notes          String?
  isDeleted      Boolean        @default(false) @map("is_deleted")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz
  purchaseItems  PurchaseItem[]
  supplier       Supplier       @relation(fields: [supplierId], references: [id])

  @@index([organizationId, isDeleted, purchaseDate])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String    @id @default(cuid())
  purchaseId String    @map("purchase_id")
  productId  String    @map("product_id")
  quantity   Int
  unitPrice  Decimal   @map("unit_price") @db.Decimal(12, 2)
  subtotal   Decimal   @db.Decimal(12, 2)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  product    Product   @relation(fields: [productId], references: [id])
  purchase   Purchase  @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  productId      String            @map("product_id")
  storeId        String?           @map("store_id")
  type           StockMovementType
  quantity       Int
  previousStock  Int               @map("previous_stock")
  newStock       Int               @map("new_stock")
  reason         String?
  userId         String?           @map("user_id")
  reference      String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization      @relation(fields: [organizationId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  user           User?             @relation(fields: [userId], references: [id])

  @@index([organizationId, productId, createdAt])
  @@index([productId])
  @@index([userId])
  @@index([storeId])
  @@map("stock_movements")
}

model SystemConfig {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  key            String
  value          String
  type           String       @default("STRING")
  description    String?
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id])

  // unique (organization_id, key) WHERE deleted_at IS NULL — partial index in SQL
  @@index([organizationId, isDeleted])
  @@map("system_configs")
}

enum UserRole {
  ADMIN
  SELLER

  @@map("user_role")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT

  @@map("stock_movement_type")
}

enum PaymentType {
  CASH
  CARD
  TRANSFER
  CREDIT
  CHECK
  OTHER

  @@map("payment_type")
}

enum SaleStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED

  @@map("sale_status")
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED

  @@map("purchase_status")
}

// ============================================
// ENUM AUDIT ACTION - ACCIONES DE AUDITORÍA
// ============================================
enum AuditAction {
  // Autenticación
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED

  // CRUD genérico
  CREATE
  READ
  UPDATE
  DELETE
  RESTORE

  // Acciones específicas
  ROLE_CHANGED
  ORGANIZATION_CHANGED
  STORE_CHANGED
  SESSION_REVOKED

  @@map("audit_action")
}
