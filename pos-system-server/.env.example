# pos-system-server environment
# Copy to .env and fill in. Fase 1/2 will make JWT_SECRET and DATABASE_URL required.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# JWT_SECRET=                  # min 32 chars — required from Fase 2
# DATABASE_URL=                # pooled Prisma URL — required from Fase 1
# DIRECT_URL=                  # migrations URL — required from Fase 1
